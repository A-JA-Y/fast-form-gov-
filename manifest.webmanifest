{
  "name": "GovForms — Auto Document Formatter",
  "short_name": "GovForms",
  "description": "Format exam photos, signatures and ID documents to exact pixel sizes and KB limits, entirely on your device.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#050915",
  "theme_color": "#050915",
  "lang": "en-IN",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Open the Studio",
      "short_name": "Studio",
      "url": "./?source=pwa#studio",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Merge into one PDF",
      "short_name": "Merge",
      "url": "./?source=pwa#merge",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Vacancy news",
      "short_name": "News",
      "url": "./?source=pwa#news",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
